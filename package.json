{
  "name": "dafung-web",
  "version": "2026.10.1",
  "private": true,
  "description": "群雄逐鹿 — 三国古风水墨大富翁(React + Bun,安卓 APK 为正式交付形态,网页构建仅作开发与 AI 自动化测试通道)",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "play": "bun scripts/play.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "build": "bun run --bun tsc --noEmit && bun run --bun vite build",
    "preview": "bun run --bun vite preview --port 4173",
    "typecheck": "bun run --bun tsc --noEmit",
    "check:core": "bun scripts/check-core-purity.ts",
    "check:core:baseline:update": "bun scripts/check-core-purity.ts baseline:update",
    "check:freshness": "bun scripts/check-freshness.ts",
    "check:fmt": "oxfmt --check",
    "check:links": "bun scripts/check-doc-links.ts",
    "check:retired": "bun scripts/check-retired-phrases.ts",
    "check:map-docs": "bun scripts/check-map-docs.ts",
    "check:e2e-testids": "bun scripts/check-e2e-testids.ts",
    "test": "bun scripts/test-lock.ts bun test",
    "test:slow": "DAFUNG_SLOW=1 bun scripts/test-lock.ts bun test",
    "playwright": "echo 'playwright runner 必须跑在 Node 上:请用 npx playwright 或 bun run test:e2e(bun 下 pw 静默 exit 0 且 0 用例,详见 playwright.config.ts 头注释)' && exit 1",
    "test:e2e": "bun scripts/test-lock.ts bun run test:e2e:one",
    "test:e2e:one": "bun run --bun vite build && playwright test",
    "serve": "bun scripts/server.ts",
    "typecheck:scripts": "bun run --bun tsc --noEmit -p tsconfig.scripts.json",
    "tauri": "tauri",
    "tauri:desktop": "tauri dev",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "release": "bun scripts/release.ts",
    "gen:theme": "bun scripts/generate-theme-tokens.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "1.55.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
