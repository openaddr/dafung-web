{
  "name": "dafung-web",
  "version": "1.0.0",
  "private": true,
  "description": "群雄逐鹿 — 三国古风水墨大富翁(React + Bun,浏览器可自动化测试)",
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun tsc --noEmit && bun run --bun vite build",
    "preview": "bun run --bun vite preview --port 4173",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "serve:e2e": "bun run --bun vite preview --port 4173 --strictPort",
    "serve": "bun scripts/server.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "tauri": "tauri",
    "tauri:desktop": "tauri dev",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "gen:theme": "bun scripts/generate-theme-tokens.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.55.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  }
}
