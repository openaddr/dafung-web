{
  "name": "dafung-web",
  "version": "1.0.0",
  "private": true,
  "description": "群雄逐鹿 — 三国古风水墨大富翁(TypeScript + DOM/SVG,浏览器可自动化测试)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve:e2e": "vite preview --port 4173 --strictPort",
    "serve": "tsx scripts/server.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "tauri": "tauri",
    "tauri:desktop": "tauri dev",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "gen:theme": "tsx scripts/generate-theme-tokens.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zustand": "^5.0.15"
  }
}
