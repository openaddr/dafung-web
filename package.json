{
  "name": "dafung-web",
  "version": "1.0.0",
  "private": true,
  "description": "群雄逐鹿 — 三国古风水墨大富翁(TypeScript + DOM/SVG,浏览器可自动化测试)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve:e2e": "vite preview --port 4173 --strictPort",
    "tauri": "tauri",
    "tauri:desktop": "tauri dev",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
