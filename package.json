{
  "name": "dafung-web",
  "version": "2026.11.53",
  "private": true,
  "description": "群雄逐鹿 — 三国古风水墨大富翁(React + Bun,安卓 APK 为正式交付形态,网页构建仅作开发和用户明确要求的单次排查通道)",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "play": "bun scripts/play.ts",
    "lint": "oxlint && bun run check:test-boundaries",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "build": "bun scripts/build-dist.ts --typecheck",
    "build:bundle": "bun scripts/build-dist.ts",
    "preview": "bun run --bun vite preview --port 4173",
    "visual:compare": "node scripts/visual-compare.mjs",
    "probe:frames": "node scripts/frame-probe.ts",
    "probe:cost": "node scripts/cost-probe.ts",
    "sim:digest": "bun scripts/sim-digest.ts",
    "typecheck": "bun run --bun tsc --noEmit",
    "check:core": "bun scripts/check-core-purity.ts",
    "check:board": "bun scripts/check-board-anim.ts",
    "check:core:baseline:update": "bun scripts/check-core-purity.ts baseline:update",
    "check:goldens": "bun scripts/check-goldens.ts",
    "check:goldens:update": "bun scripts/check-goldens.ts update",
    "check:sim-bench": "bun scripts/sim-bench.ts",
    "check:sim-bench:update": "bun scripts/sim-bench.ts update",
    "check:freshness": "bun scripts/check-freshness.ts",
    "validate": "bun scripts/validate.ts",
    "check:agents-budget": "bun scripts/check-agents-budget.ts",
    "check:fmt": "oxfmt --check",
    "check:links": "bun scripts/check-doc-links.ts",
    "check:retired": "bun scripts/check-retired-phrases.ts",
    "check:fake-bold": "bun scripts/check-fake-bold.ts",
    "check:map-docs": "bun scripts/check-map-docs.ts",
    "test": "bun scripts/test-lock.ts --entry test bun scripts/bun-release.ts",
    "test:slow": "DAFUNG_SLOW=1 bun scripts/test-lock.ts --entry test:slow bun scripts/bun-release.ts",
    "serve": "bun scripts/server.ts",
    "typecheck:scripts": "bun run --bun tsc --noEmit -p tsconfig.scripts.json",
    "tauri": "tauri",
    "tauri:desktop": "tauri dev",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "test:apk": "bun scripts/apk-smoke.ts",
    "release": "bun scripts/release.ts",
    "gen:theme": "bun scripts/generate-theme-tokens.ts",
    "check:test-boundaries": "bun scripts/check-test-boundaries.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "2.6.0",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@sinonjs/fake-timers": "^15.4.0",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "1.55.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
