# ===== 依赖与构建产物(可再生)=====
node_modules/
dist/

# ===== 测试与截图自证产物(可再生;e2e 输出 tmp/test-results/(playwright.config outputDir),截图脚手架 shot.mjs 工作区也在 tmp/)=====
tmp/
*.log
# dogfood QA 证据截图只留本地不入库,报告 docs/dogfood/report.md 照常入库
docs/dogfood/screenshots/

# ===== 引擎/服务器运行时状态 =====
# CLI 每命令一进程的引擎持久化
state.json
state.*.json
# 房间落盘 + 对局日志(ADR-0014),归拢在 data/:默认 ./data/rooms、./data/logs;
# e2e 用 ./tmp/e2e-rooms,dev 用 ./tmp/dev-rooms(与生产互不踩)
data/

# ===== 本机环境与密钥 =====
.env

# ===== 工具 / 编辑器 / agent 会话本地产物 =====
.DS_Store
.claude/
.idea/
.reasonix/
.zcode/
.playwright-mcp/
# video-agent-kit 插件产物(plugin_root 指向本机插件缓存路径)
.video_agent/
# agent/skill 工作底稿(spec 草案、一次性迁移报告等;工单完结可清)
.scratch/
.migration/

# ===== UI 参考图库:白名单反选(口径单源见 docs/design/ui-reference/README.md) =====
# 仅 README / research-*.md / manifest.jsonl / current-ui/ 入库;网图与第三方素材仅本地参考
docs/design/ui-reference/*
!docs/design/ui-reference/README.md
!docs/design/ui-reference/research-*.md
!docs/design/ui-reference/manifest.jsonl
!docs/design/ui-reference/current-ui/
